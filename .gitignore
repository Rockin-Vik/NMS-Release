# FUSE mount artefacts - left behind when a file is edited while still open over a
# network/virtual mount. Never real content.
.fuse_hidden*

# Visual Studio & IDE caches
.vs/
*.user
*.suo
*.userosv
*.sln.docstates
*.VC.db
*.opendb
*.ipch
*.idb
*.pdb

# Gradle & Build cache outputs
.gradle/
buildOutputCleanup/
build/
bin/
out/

# vcpkg dependencies (~132 MB, plus a >100MB archive that GitHub would reject).
#
# Not committed, and deliberately so: CMake fetches these on the first configure
# via cmake/DependencyHelperMSVC.cmake. A partial copy used to be tracked here,
# but the bare 'bin/' rule above applies at every depth and silently excluded
# every runtime DLL from it - so the committed tree looked vendored while being
# unusable offline. Better to fetch it honestly than to half-ship it.
Release-NMS-Server/vcpkg/
